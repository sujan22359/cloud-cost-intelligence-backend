# ─────────────────────────────────────────────────────────────────────────────
# Cloud Cost Intelligence Backend — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────

# ── Authentication Credentials ───────────────────────────────────────────────
LOGIN_EMAIL=infrastructureteam@ssi.safestart.com
LOGIN_PASSWORD=admin@359
JWT_SECRET_KEY=cloud-cost-intelligence-jwt-secret-key-prod-2026-secure

# ── AWS Account Credentials & Region ─────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_SESSION_TOKEN=

# ── Amazon S3 Bucket & Structure Configuration ──────────────────────────────
AWS_S3_BUCKET=your_cost_reports_bucket_name
AWS_ACCOUNT_MASTER_PREFIX=account_master/
AWS_ACCOUNT_MASTER_FILE=account_master/Account.csv
AWS_COST_EXPLORER_PREFIX=cost-explorer/

# ── AWS Boto3 Transport & Retries ──────────────────────────────────────────
AWS_CONNECT_TIMEOUT=10
AWS_READ_TIMEOUT=30
AWS_MAX_RETRIES=3

# ── Amazon Bedrock LLM ────────────────────────────────────────────────────────
BEDROCK_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
BEDROCK_MAX_TOKENS=2048
BEDROCK_TEMPERATURE=0.2
BEDROCK_TOP_P=1.0

# ── PostgreSQL Database (Amazon RDS / Local PostgreSQL) ───────────────────────
DATABASE_URL=postgresql+psycopg://dbuser:dbpassword@rds-endpoint.amazonaws.com:5432/costdb
POSTGRES_HOST=rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_DB=costdb
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpassword

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
BATCH_INSERT_SIZE=1000

# ── Application Settings ──────────────────────────────────────────────────────
APP_NAME="Cloud Cost Intelligence"
APP_VERSION=1.0.0
LOG_LEVEL=INFO
DEBUG=false
DOWNLOAD_DIR=downloads
LOG_DIR=logs

DEFAULT_TOP_K=5
DEFAULT_PAGINATION_SIZE=10
REQUEST_TIMEOUT_SECONDS=30
MAX_UPLOAD_SIZE_BYTES=10485760
CACHE_TTL_SECONDS=300
